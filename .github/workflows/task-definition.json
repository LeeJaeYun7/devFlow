{
  "family": "devflow-backend-task-definition",
  "containerDefinitions": [
    {
      "name": "devflow-backend-container",
      "image": "058264441782.dkr.ecr.ap-northeast-2.amazonaws.com/devflow",
      "portMappings": [
        {
          "containerPort": 4600,
          "hostPort": 4600,
          "protocol": "tcp"
        },
        {
          "containerPort": 80,
          "hostPort": 4600,
          "protocol": "tcp"
        }
      ],
      "cpu": 256, 
      "memory": 512,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "ecs/devflow-task-definition",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "devflow-backend-container"
        }
      },
      "essential": true
    }
  ],
  "requiresCompatibilities": [ "FARGATE" ],
  "cpu": "256", 
  "memory": "512",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::058264441782:role/ecsTaskExecutionRole"
}
