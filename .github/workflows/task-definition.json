{
  "family": "devflow-backend-task-definition",
  "containerDefinitions": [
    {
      "name": "devflow-backend-container",
      "image": "058264441782.dkr.ecr.ap-northeast-2.amazonaws.com/devflow",
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 0,
          "protocol": "tcp"
        }
      ],
      "cpu": 256, // 컨테이너 수준의 CPU (선택 사항이지만 명시하는 것을 권장)
      "memory": 512 // <- 이 부분을 추가하세요! (예시 값: 512 MiB)
      // 또는 "memoryReservation": 256
    }
  ],
  "requiresCompatibilities": [ "FARGATE" ], // Fargate 런치 타입을 사용한다면 필수
  "cpu": "256", // 태스크 수준의 CPU (Fargate 사용 시 필수)
  "memory": "512", // 태스크 수준의 메모리 (Fargate 사용 시 필수)
  "networkMode": "awsvpc" // Fargate 사용 시 필수
}
